    local UIS2 = game:GetService("UserInputService")

    local function makeSlider(track, fill, knob, lbl, minVal, maxVal, defaultVal, fmt)
        local isDragging = false
        local function update(pct)
            pct = math.clamp(pct, 0, 1)
            local val = minVal + (maxVal - minVal) * pct
            if fmt == "int" then val = math.round(val) end
            val = math.floor(val * 10 + 0.5) / 10  -- round to 1dp
            fill.Size = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, .5, 0)
            if fmt == "int" then
                lbl.Text = lbl.Name:match("Speed") and ("Speed: "..tostring(math.round(val)))
                    or lbl.Text
                if lbl.Name == "SpeedLabel" then lbl.Text = "Speed: "..tostring(math.round(val)) end
            elseif fmt == "rot" then
                local rv = math.round(minVal + (maxVal-minVal)*pct)
                lbl.Text = "Rotation: "..rv
                _movVars.rotation = rv
            elseif fmt == "dep" then
                local dv = math.floor((minVal + (maxVal-minVal)*pct)*10+0.5)/10
                lbl.Text = "Depth: "..string.format("%.1f", dv)
                _movVars.depth = dv
            elseif fmt == "spd" then
                local sv = math.round(minVal + (maxVal-minVal)*pct)
                lbl.Text = "Speed: "..sv
                _movVars.speed = sv
                -- apply walkspeed if character exists
                local lp2 = game:GetService("Players").LocalPlayer
                local char = lp2 and lp2.Character
                local hum  = char and char:FindFirstChildWhichIsA("Humanoid")
                if hum then hum.WalkSpeed = sv end
            end
        end

        knob.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or
               inp.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
            end
        end)
        track.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or
               inp.UserInputType == Enum.UserInputType.Touch then
                isDragging = true
                local relX = inp.Position.X - track.AbsolutePosition.X
                local pct  = relX / track.AbsoluteSize.X
                update(pct)
            end
        end)
        UIS2.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 or
               inp.UserInputType == Enum.UserInputType.Touch then
                isDragging = false
            end
        end)
        UIS2.InputChanged:Connect(function(inp)
            if isDragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or
               inp.UserInputType == Enum.UserInputType.Touch) then
                local relX = inp.Position.X - track.AbsolutePosition.X
                local pct  = relX / track.AbsoluteSize.X
                update(pct)
            end
        end)
        -- set initial
        update((defaultVal - minVal) / (maxVal - minVal))
    end

    makeSlider(rotTrack, rotFill, rotKnob, rotLbl,  0,   360, 180, "rot")
    makeSlider(depTrack, depFill, depKnob, depLbl,  0.5, 10.5, 5.0, "dep")
    makeSlider(spdTrack, spdFill, spdKnob, spdLbl, 16,  100,  27,  "spd")
end

