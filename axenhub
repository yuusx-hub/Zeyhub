task.defer(function()
    local sp = gui:FindFirstChild("XenhubV5")
    if not sp then return end
    local navFrame = sp:FindFirstChild("NavFrame")
    local contentFrame = sp:FindFirstChild("ContentFrame")
    if not navFrame or not contentFrame then return end

    local tabNames = {"Keybinds","Auto TP","ESP","UI","Misc","Priority","Performance"}
    local tabs = {}
    for _, btn in ipairs(navFrame:GetChildren()) do
        if btn:IsA("TextButton") then table.insert(tabs, btn) end
    end
    table.sort(tabs, function(a,b) return a.LayoutOrder < b.LayoutOrder end)

    local function switchTab(targetName)
        for _, name in ipairs(tabNames) do
            local sf = contentFrame:FindFirstChild(name)
            if sf then sf.Visible = (name == targetName) end
        end
        for i, btn in ipairs(tabs) do
            local name = tabNames[i]
            if name == targetName then
                btn.BackgroundColor3 = Color3.fromRGB(99,102,241)
                btn.BackgroundTransparency = 0.3
                btn.TextColor3 = Color3.fromRGB(255,255,255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(40,40,50)
                btn.BackgroundTransparency = 0.7
                btn.TextColor3 = Color3.fromRGB(115,115,130)
            end
        end
    end
    for i, btn in ipairs(tabs) do
        local name = tabNames[i]
        if name then
            btn.MouseButton1Click:Connect(function() switchTab(name) end)
        end
    end
    switchTab("UI")
end)

-- ── Draggable panels ─────────────────────────────────────────
local function makeDraggable(frame, handle)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = input.Position; startPos = frame.Position
        end
    end)
    handle.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
        end
    end)
end

